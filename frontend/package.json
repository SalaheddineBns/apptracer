{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "start-server-and-test start http://localhost:4200 cy:run",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
