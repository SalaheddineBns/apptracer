    "/api/v1/auth/login" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Se connecter avec son e-mail et son mot de passe",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
