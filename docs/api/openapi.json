    "/api/v1/auth/refresh" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Renouveler la session avec un refresh token (usage unique)",
        "operationId" : "refreshSession",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshSessionRequest"
              }
            }
          },
          "required" : true
