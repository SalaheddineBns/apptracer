              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Users" ],
        "summary" : "Créer un compte avec un mot de passe initial",
        "operationId" : "createUser",
        "requestBody" : {
