        "responses" : {
          "200" : {
            "description" : "Page de comptes",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageUserResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Paramètre de pagination ou de tri invalide",
