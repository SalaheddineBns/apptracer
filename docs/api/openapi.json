        "tags" : [ "Authentication" ],
        "summary" : "Se déconnecter (révoque le refresh token)",
        "operationId" : "logout",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LogoutRequest"
